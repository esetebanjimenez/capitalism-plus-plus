{
  "name": "capitalism-client",
  "private": true,
  "description": "Capitalism++ M2 web client (map renderer). See client/README.md",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && npm run build",
    "screenshot": "node scripts/screenshot.mjs",
    "bench": "node scripts/bench.mjs",
    "bundle": "python3 ../scripts/pyodide_bundle.py public/capitalism.zip",
    "pyodide": "node scripts/fetch-pyodide.mjs",
    "boot-check": "node scripts/boot-check.mjs",
    "predev": "npm run bundle && npm run pyodide",
    "prebuild": "npm run bundle && npm run pyodide"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "puppeteer-core": "^23.10.0",
    "pyodide": "314.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
